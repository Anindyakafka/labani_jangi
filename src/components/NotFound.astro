---
import Layout from '../layouts/Layout.astro';
import { translator, localPath, type Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = translator(locale);
---
<Layout locale={locale} title={t('Page not found : Labani Jangi')}><section class="wrap article"><span class="eyebrow">{t('404 / Page not found')}</span><h1>{t('Another')}<br/>{t('way back.')}</h1><p>{t('This page could not be found.')}</p><a class="text-link" href={localPath('/', locale)}>{t('Return to the home page')} →</a></section></Layout>
