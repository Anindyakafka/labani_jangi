---
import Layout from '../layouts/Layout.astro';
import WestBengalMap from './WestBengalMap.astro';
import { publishedArchive } from '../lib/archive';
import { translator, localPath, type Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = translator(locale);
import { instagram, sources } from '../data/site';
const entries = (await publishedArchive(locale)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const works = entries.filter(e => e.data.kind === 'work');
const writings = entries.filter(e => e.data.kind === 'writing');
const conversations = entries.filter(e => e.data.kind === 'conversation');
---
<Layout locale={locale}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="eyebrow hero-meta"><span>{t('Artist · Researcher · Cultural practitioner')}</span><span>{t('West Bengal, India')}</span></div>
    <h1 id="hero-title">{t('Labani')}<br/><span>{t('Jangi')}<span class="period">.</span></span></h1>
    <div class="hero-bottom"><p>{t('My art, lived experience')}<br/>{t('and the language of resistance.')}</p><a class="round-link" href="#practice" aria-label={t('Explore my practice')}>↓</a><span class="vertical-note" aria-hidden="true">{t('My space for art & thought')}</span></div>
  </section>
  <WestBengalMap locale={locale} />
  <section id="practice" class="practice section">
    <div class="wrap split"><div><span class="eyebrow">{t('01 / Practice')}</span><h2>{t('From life.')}<br/>{t('Towards')}<br/><em>{t('resistance.')}</em></h2></div>
      <div class="practice-copy"><span class="asterisk" aria-hidden="true">✳</span><p class="large-copy">{t('My practice brings art into conversation with lived experience, identity and solidarity.')}</p><p>{t('My work engages with the lives and expression of minority communities, drawing on cultural traditions including Bengal’s Jari Gaan.')}</p><a class="text-link" href={sources[2].url} data-umami-event="publication-map">{t('Read about my practice at MAP')} ↗</a></div>
    </div>
  </section>
  {works.length > 0 && <section class="wrap section" id="works"><span class="eyebrow">{t('Works')}</span><h2>{t('Selected work')}</h2><div class="work-grid">{works.map(entry => <a class="work-card" href={localPath(`/archive/${entry.data.translationKey}/`, locale)} data-umami-event={entry.data.kind + "-open"}>{entry.data.image && <img src={entry.data.image} alt={entry.data.imageAlt} loading="lazy" />}<h3>{entry.data.title}</h3><p>{entry.data.series || entry.data.medium}</p></a>)}</div></section>}
  <section id="archive" class="wrap section archive">
    <div class="section-heading"><div><span class="eyebrow">{t('02 / Reading & conversations')}</span><h2>{t('In the public eye')}<span class="period">.</span></h2></div><p>{t('Profiles, interviews')}<br/>{t('and conversations.')}</p></div>
    <div class="source-list">{sources.map((source, i) => <a class="source-row" href={source.url} data-umami-event={"publication-" + source.publisher.toLowerCase().replaceAll(" ", "-")}><span class="row-number">{(i+1).toLocaleString(locale, {minimumIntegerDigits:2})}</span><div><span class="eyebrow">{t(source.publisher)}</span><h3>{t(source.title)}</h3></div><span class="source-type">{t(source.type)}</span><span class="arrow" aria-hidden="true">↗</span></a>)}</div>
    {conversations.map(entry => <a class="archive-note" href={localPath(`/archive/${entry.data.translationKey}/`, locale)} data-umami-event={entry.data.kind + "-open"}><span class="eyebrow">{t('From the archive')}</span><span>{entry.data.title} — {t('programme notes')}</span><span aria-hidden="true">→</span></a>)}
  </section>
  {writings.length > 0 && <section class="wrap section"><span class="eyebrow">{t('Writings')}</span><h2>{t('Words & reflections')}</h2>{writings.map(entry => <a class="source-row" href={localPath(`/archive/${entry.data.translationKey}/`, locale)} data-umami-event={entry.data.kind + "-open"}><h3>{entry.data.title}</h3><span aria-hidden="true">→</span></a>)}</section>}
  <section id="about" class="about section"><div class="wrap split"><div><span class="eyebrow">{t('03 / About me')}</span><h2>{t('An artist.')}<br/>{t('A researcher.')}<br/>{t('A cultural')}<br/><em>{t('practitioner.')}</em></h2></div><div class="about-copy"><p class="large-copy">{t('My roots are in Nadia,')}<br/>{t('West Bengal.')}</p><p>{t('I’m Labani Jangi, an artist, research scholar and cultural practitioner. My practice explores resistance and identity through the world around me.')}</p><p>{t('My involvement with Panjeri Artists’ Union, JINN and Khandera Art Space is documented in MAP’s 2025 profile. I am also a recipient of the T.M. Krishna–PARI prize.')}</p><a class="text-link" href={sources[2].url} data-umami-event="publication-map">{t('My artist profile · MAP, 2025')} ↗</a></div></div></section>
  <section id="contact" class="wrap contact section"><span class="eyebrow">{t('04 / Keep in touch')}</span><div class="contact-line"><h2>{t('Let’s continue the')}<br/><em>{t('conversation.')}</em></h2><a class="contact-button" href={instagram} data-umami-event="instagram-click">{t('Find me on Instagram')} <span aria-hidden="true">↗</span></a></div></section>
</Layout>
