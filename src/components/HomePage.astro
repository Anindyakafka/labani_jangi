---
import Layout from '../layouts/Layout.astro';
import WestBengalMap from './WestBengalMap.astro';
import { featuredWork } from '../data/featured-work';
import '../styles/ground-home.css';
import { translator, localPath, type Locale, type TranslationKey } from '../i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = translator(locale);
const routes = [
  ['Practice', '/practice/', 'From life, towards resistance.'],
  ['Works', '/works/', 'Selected work'],
  ['Artworks', '/artworks/', 'Political work and Palestine.'],
  ['Archive', '/archive/', 'Reading and conversations.'],
  ['About', '/about/', 'About me'],
] as const satisfies ReadonlyArray<readonly [TranslationKey, string, TranslationKey]>;
const introArtwork = featuredWork.find((work) => work.title === 'Rural healthcare');
if (!introArtwork) throw new Error('The rural-healthcare homepage artwork is missing from featured-work.');
const number = new Intl.NumberFormat(locale === 'bn' ? 'bn-BD' : 'en');
---
<Layout locale={locale}>
  <section class="ground-hero" aria-labelledby="home-title">
    <div class="ground-hero-inner">
      <div class="ground-hero-copy">
        <p class="ground-hero-meta eyebrow">
          <span>{t('Artist · Researcher · Cultural practitioner')}</span>
          <span>{t('West Bengal, India')}</span>
        </p>
        <h1 id="home-title">
          <span>{t('Labani')}</span>
          <span class="ground-surname">{t('Jangi')}<span class="ground-period">.</span></span>
        </h1>
        <p class="ground-hero-voice">
          <span>{t('My art, lived experience')}</span>
          <span>{t('and the language of resistance.')}</span>
        </p>
        <p class="ground-home-note">{t('Nadia · My home district')}</p>
      </div>
      <div class="ground-hero-map">
        <WestBengalMap locale={locale} />
      </div>
    </div>
  </section>

  <section class="ground-introduction wrap" id="ground-introduction" aria-labelledby="ground-introduction-title">
    <div class="ground-introduction-copy">
      <p class="eyebrow">{t('About me')}</p>
      <h2 id="ground-introduction-title">
        <span>{t('A practice shaped by')}</span>
        <span>{t('place and people.')}</span>
      </h2>
      <p class="ground-introduction-statement">{t('I understand art as a place of dialogue: a way to hold personal narratives alongside collective voices, and to keep space for lives that are too often made invisible.')}</p>
      <p class="ground-introduction-roots">{t('My roots are in Nadia, West Bengal.')}</p>
      <a class="ground-read-more" href={localPath('/about/', locale)}>
        {t('Read more about my roots')} <span aria-hidden="true">↗</span>
      </a>
    </div>
    <figure class="ground-artwork">
      <img
        src={introArtwork.image}
        alt={t(introArtwork.alt)}
        width="1400"
        height="908"
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        <span>{t(introArtwork.title)}</span>
      </figcaption>
    </figure>
  </section>

  <section class="ground-paths wrap" aria-labelledby="ground-paths-title">
    <div class="ground-paths-heading">
      <p class="eyebrow">{t('Explore')}</p>
      <h2 id="ground-paths-title">{t('Ways into my work')}</h2>
    </div>
    <nav class="ground-path-grid" aria-label={t('Explore the website')}>
      {routes.map(([label, path, description], index) => <a
        href={localPath(path, locale)}
        class="ground-path-card"
      >
        <span class="ground-path-number" aria-hidden="true">{number.format(index + 1)}</span>
        <span class="ground-path-copy">
          <span class="ground-path-title">{t(label)}</span>
          <span class="ground-path-description">{t(description)}</span>
        </span>
        <span class="ground-path-arrow" aria-hidden="true">↗</span>
      </a>)}
    </nav>
  </section>
</Layout>
