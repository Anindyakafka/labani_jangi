---
import { districtNames, type Locale } from '../i18n';
import districts from '../data/west-bengal.json';

interface Props { locale: Locale; }
const { locale } = Astro.props;
for (const district of districts) {
  if (!districtNames[district.id]) throw new Error(`Missing Bangla district name: ${district.id}`);
}
---
<svg class="journey-map" viewBox="0 0 440 570" role="img" aria-labelledby="journey-map-title journey-map-description" data-journey-map>
  <title id="journey-map-title">{locale === 'bn' ? 'পশ্চিমবঙ্গের মানচিত্র' : 'Map of West Bengal'}</title>
  <desc id="journey-map-description">{locale === 'bn' ? 'পশ্চিমবঙ্গের তেইশটি জেলার একটি মানচিত্র।' : 'A map of the 23 districts of West Bengal.'}</desc>
  {districts.map((district) => <path
    d={district.path}
    data-district-id={district.id}
    class:list={['journey-district', { 'journey-district-home': district.id === 'nadia' }]}
    fill-rule="evenodd"
    aria-label={locale === 'bn' ? districtNames[district.id] : district.name}
  ><title>{locale === 'bn' ? districtNames[district.id] : district.name}</title></path>)}
</svg>
