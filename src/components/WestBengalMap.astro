---
import { translator, districtNames, type Locale } from '../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = translator(locale);
import districts from '../data/west-bengal.json';
for (const district of districts) {
  if (!districtNames[district.id]) throw new Error(`Missing Bangla district name: ${district.id}`);
}
---
<section class="roots-map wrap" aria-labelledby="roots-title">
  <div class="roots-copy">
    <span class="eyebrow">{t('My roots / West Bengal')}</span>
    <h2 id="roots-title">{t('Nadi')}<br/>{t('aar')} <em>{t('Nadia.')}</em></h2>
    <p class="large-copy">{t('Nadia, West Bengal.')}</p>
    <p>{t('My life and practice are rooted here.')}</p>
    <div class="map-key"><span aria-hidden="true"></span> {t('Nadia · My home district')}</div>
  </div>
  <figure class="bengal-figure">
    <svg class="bengal-map" viewBox="0 0 440 570" role="img" aria-labelledby="bengal-title bengal-description">
      <title id="bengal-title">{t('West Bengal, with Nadia highlighted')}</title>
      <desc id="bengal-description">{t('A map showing 23 district shapes from the geoBoundaries 2021 dataset. Nadia, my home district, is highlighted in red.')}</desc>
      {districts.map(district => <path d={district.path} data-district-id={district.id} data-source-id={district.sourceId} class:list={['district', {'district-home': district.id === 'nadia'}]} fill-rule="evenodd"><title>{locale === 'bn' ? districtNames[district.id] : district.name}</title></path>)}
    </svg>
    <figcaption>{t('District boundaries · 2021 dataset')}<br/><a href="https://www.geoboundaries.org/">{t('geoBoundaries')}</a> / {t('Pathways Data')} · <a href="https://opendatacommons.org/licenses/odbl/1-0/">{t('ODbL 1.0')}</a> · <a href="/maps/west-bengal.geojson" download>{t('Map data')} ↓</a></figcaption>
  </figure>
</section>
<style>
  .roots-map{display:grid;grid-template-columns:1fr 1fr;gap:8%;align-items:center;padding-block:65px 75px;border-top:1px solid var(--line)}
  .roots-copy h2{margin-bottom:30px}.roots-copy>p:not(.large-copy){font-size:14px;line-height:1.8}
  .map-key{display:flex;align-items:center;gap:12px;margin-top:35px;font-size:11px;letter-spacing:.3px}.map-key span{width:12px;height:12px;background:var(--red)}
  .bengal-figure{margin:0;text-align:center}.bengal-map{width:100%;max-width:400px;height:auto;overflow:visible}
  .district{fill:var(--paper);stroke:var(--red);stroke-width:.8;vector-effect:non-scaling-stroke;stroke-linejoin:round}
  .district-home{fill:var(--red)}
  figcaption{font-size:9px;line-height:1.9;color:var(--muted);margin-top:15px}figcaption a{text-decoration:underline;text-underline-offset:3px}
  @media(max-width:760px){.roots-map{grid-template-columns:1fr;gap:35px;padding-block:50px}.bengal-map{max-width:330px}.roots-copy h2{font-size:48px}}
</style>
