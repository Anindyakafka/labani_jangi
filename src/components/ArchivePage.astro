---
import { render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { translator, localPath } from '../i18n';
interface Props { entry: CollectionEntry<'archive'>; }
const { entry } = Astro.props;
const locale = entry.data.language;
const t = translator(locale);
const { Content } = await render(entry);
---
<Layout locale={locale} title={`${entry.data.title} : ${t('Labani Jangi')}`} description={entry.data.description}>
  <article class="wrap article" lang={locale}>
    <a class="text-link" href={localPath('/#archive', locale)}>← {t('Back to the archive')}</a>
    <div class="eyebrow article-meta">{t(entry.data.kind)} / <time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString(locale === 'bn' ? 'bn-IN' : 'en-GB', {day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time></div>
    <h1>{entry.data.title}</h1><p class="large-copy">{entry.data.description}</p>
    {entry.data.image && <figure><img src={entry.data.image} alt={entry.data.imageAlt} /><figcaption>{entry.data.credit}</figcaption></figure>}
    <div class="prose"><Content /></div>
    {entry.data.video && <p><a class="text-link" href={entry.data.video} data-umami-event="video-link-click">{t('Watch the video')} ↗</a></p>}
    {entry.data.source && <p class="source-credit">{t('Source:')} <a href={entry.data.source} data-umami-event="archive-source-click">{entry.data.sourceName || t('Original publication')} ↗</a></p>}
  </article>
</Layout>
