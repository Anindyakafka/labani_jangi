---
import Layout from '../layouts/Layout.astro';
import WorkGallery from './WorkGallery.astro';
import { translator, type Locale } from '../i18n';
const { locale } = Astro.props as { locale: Locale };
const t = translator(locale);
---
<Layout locale={locale} title={t('My practice — Labani Jangi')} description={t('My artistic practice moves through lived experience, research, memory and solidarity.')}>
  <section class="wrap page-hero"><span class="eyebrow">{t('Practice')}</span><h1>{t('From life, towards resistance.')}</h1><p class="large-copy">{t('I make images to tell stories, draw emotions and find a language for what I encounter in everyday life.')}</p></section>
  <section class="practice section"><div class="wrap split"><div><span class="eyebrow">{t('Artist statement')}</span><h2>{t('Memory,') }<br/><em>{t('solidarity,')}</em><br/>{t('imagination.')}</h2></div><div class="practice-copy"><p>{t('My work is rooted in lived experience and attends to the fractures and solidarities around me. Jari Gaan, Muharram and the lives of Bengali migrant labourers shape the questions I ask about memory, identity and representation.')}</p><p>{t('I understand art as a place of dialogue: a way to hold personal narratives alongside collective voices, and to keep space for lives that are too often made invisible.')}</p></div></div></section>
  <section class="wrap section"><span class="eyebrow">{t('Rural realities')}</span><h2>{t('Journalism and art')}</h2><p class="intro-copy">{t('My work with rural journalism brings illustration into conversation with reporting, poetry and the lived experience of communities. The images below are a small selection; the original reporting remains with its publishers and writers.')}</p><WorkGallery locale={locale} section="rural" /></section>
</Layout>
