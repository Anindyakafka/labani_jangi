---
import { translator, localPath, type Locale } from '../i18n';
import '../styles/global.css';
import '@fontsource/noto-serif-bengali/bengali-400.css';
import { instagram } from '../data/site';
interface Props { locale?: Locale; title?: string; description?: string; ogImage?: string; }
const { locale = 'en' } = Astro.props;
const t = translator(locale);
const { title = t('Labani Jangi : Artist & cultural practitioner'), description = t('I’m Labani Jangi, an artist, researcher and cultural practitioner from Nadia, West Bengal. Explore my work and practice.'), ogImage = '/social-card.png' } = Astro.props;
const socialImage = new URL(ogImage, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
const is404 = Astro.url.pathname.includes('404');
const basePath = is404 ? '/404.html' : Astro.url.pathname.replace(/^\/bn(?=\/|$)/, '') || '/';
const banglaPath = is404 ? '/bn/404/' : localPath(basePath, 'bn');
const alternate = locale === 'en' ? banglaPath : basePath;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
    <title>{title}</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" /><link rel="apple-touch-icon" href="/favicon.svg" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} /><meta property="og:type" content="website" />
    <meta property="og:image" content={socialImage} /><meta property="og:image:alt" content={t('Labani Jangi : Artist & cultural practitioner')} />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={socialImage} />
    <link rel="alternate" hreflang="en" href={new URL(basePath, Astro.site)} />
    <link rel="alternate" hreflang="bn" href={new URL(banglaPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(basePath, Astro.site)} />
    <meta property="og:locale" content={locale === 'bn' ? 'bn_IN' : 'en_IN'} />
    <meta name="theme-color" content="#fafafa" />
    <script is:inline>
      (() => {
        const system = window.matchMedia('(prefers-color-scheme: dark)');
        let preference;
        try { preference = localStorage.getItem('labani-theme'); } catch {}
        const apply = (dark) => {
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#181515' : '#fafafa');
          document.querySelector('[data-theme-toggle]')?.setAttribute('aria-pressed', String(dark));
        };
        apply(preference === 'dark' || (preference !== 'light' && system.matches));
        document.addEventListener('DOMContentLoaded', () => {
          const button = document.querySelector('[data-theme-toggle]');
          if (!button) return;
          button.hidden = false;
          apply(document.documentElement.dataset.theme === 'dark');
          button.addEventListener('click', () => {
            preference = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
            try { localStorage.setItem('labani-theme', preference); } catch {}
            apply(preference === 'dark');
          });
        });
        system.addEventListener('change', () => {
          if (preference !== 'light' && preference !== 'dark') apply(system.matches);
        });
        window.addEventListener('storage', (event) => {
          if (event.key === 'labani-theme' || event.key === null) {
            preference = event.newValue;
            apply(preference === 'dark' || (preference !== 'light' && system.matches));
          }
        });
      })();
    </script>
    <script is:inline defer src="https://cloud.umami.is/script.js"
      data-website-id="c0819d04-f244-4caf-8922-e89e57123ae6"
      data-domains="labanijangi.com,www.labanijangi.com"
      data-exclude-hash="true" data-do-not-track="true"></script>
  </head>
  <body>
    <a class="skip" href="#main">{t('Skip to content')}</a>
    <header class="site-header wrap">
      <a class="wordmark" href={localPath('/', locale)} aria-label={t('Labani Jangi, home')}>{locale === 'bn' ? 'লজ' : 'lj'}<span>.</span></a>
      <nav aria-label={t('Main navigation')}>
        <a href={localPath('/practice/', locale)}>{t('Practice')}</a><a href={localPath('/works/', locale)}>{t('Works')}</a><a href={localPath('/artworks/', locale)}>{t('Artworks')}</a><a href={localPath('/archive/', locale)}>{t('Reading & conversations')}</a><a href={localPath('/about/', locale)}>{t('About')}</a><a href={localPath('/contact/', locale)}>{t('Contact')} <span aria-hidden="true">↗</span></a>
      </nav>
      <a class="language-toggle" href={alternate} lang={locale === 'en' ? 'bn' : 'en'} hreflang={locale === 'en' ? 'bn' : 'en'} aria-label={locale === 'en' ? 'বাংলায় পড়ুন' : 'Read in English'} data-language-switch>{locale === 'en' ? 'বাংলা' : 'English'}</a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" hidden><span aria-hidden="true">◐</span> {t('Dark mode')}</button>
    </header>
    <main id="main"><slot /></main>
    <footer class="wrap footer"><a href={localPath('/', locale)} class="footer-name">{t('Labani Jangi')}</a><span>{t('Nadia, West Bengal')}</span><a href={instagram} data-umami-event="instagram-click">{t('Instagram')} ↗</a><a href={localPath('/privacy/', locale)}>{t('Privacy')}</a><a href={localPath('/terms/', locale)}>{t('Terms')}</a><a href="#main">{t('Back to top')} ↑</a></footer>
  <script>
      document.querySelector<HTMLAnchorElement>('[data-language-switch]')?.addEventListener('click', function () {
        const target = new URL(this.href);
        target.hash = location.hash;
        this.href = target.href;
      });
    </script>
  </body>
</html>
